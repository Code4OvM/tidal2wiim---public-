@startuml
autonumber
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #176C78
skinparam LineColor #176C78
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F1F7F8
skinparam classBorderColor #176C78
skinparam componentBackgroundColor #F1F7F8
skinparam componentBorderColor #176C78
skinparam packageBackgroundColor #F8FAFB
skinparam packageBorderColor #819BA3
skinparam NoteBackgroundColor #FFF4DC
skinparam NoteBorderColor #BC8B39
skinparam NoteFontSize 15
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #F1F7F8
skinparam sequenceParticipantBorderColor #176C78
skinparam sequenceLifeLineBorderColor #819BA3
skinparam sequenceArrowThickness 1.2
hide footbox
title API 401: refresh once and retry
participant "Caller\n_apiLesen()" as C
participant "TidalAuthService" as A
participant "TIDAL OpenAPI" as API
participant "Token endpoint" as T
participant "TidalSessionStore" as S
C -> A : get(client, uri)
A -> A : Check host; restore(); remember epoch\nobtain accessToken()
A -> API : GET with bearer token
API --> A : HTTP 401
A -> A : accessToken(rejectedToken: token)
alt Another call is already refreshing
 A -> A : Wait for _refreshing\nor use an already refreshed token
else This call must refresh
 A -> T : POST /v1/oauth2/token\ngrant_type=refresh_token
 alt Valid token response
  T --> A : New token set
  A -> A : Check epoch; set new session
  A -> S : write(JSON); preserve storage order
  S --> A : Completed / storageWarning
 else invalid_grant
  T --> A : HTTP 400/401 + invalid_grant
  A -> A : forget(); increment epoch; remove session
  A -> S : write(null)
  A --> C : TidalSignInRequired; no retry
 else Network, server or format error
  T --> A : Error / unusable response
  A --> C : TidalAuthUnavailable; session is retained
 end
end
opt Usable token received
 A -> API : Exactly one more GET
 API --> A : Response
 alt HTTP 401 again
  A -> A : forget(); increment epoch; remove session
  A -> S : write(null)
  A --> C : TidalSignInRequired
 else Other HTTP status
  A --> C : Response; status checked in _apiLesen()
 end
end
note over C,A
 The expiry buffer of 60 s may trigger a refresh before the first GET.
 Without a refresh token: forget(), sign-in required; no token POST.
 403, 429 and 5xx do not trigger a 401 retry in get().
 A session change is detected using epoch.
end note
@enduml
