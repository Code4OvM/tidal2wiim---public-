@startuml
autonumber
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #176C78
skinparam LineColor #176C78
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F1F7F8
skinparam classBorderColor #176C78
skinparam componentBackgroundColor #F1F7F8
skinparam componentBorderColor #176C78
skinparam packageBackgroundColor #F8FAFB
skinparam packageBorderColor #819BA3
skinparam NoteBackgroundColor #FFF4DC
skinparam NoteBorderColor #BC8B39
skinparam NoteFontSize 15
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #F1F7F8
skinparam sequenceParticipantBorderColor #176C78
skinparam sequenceLifeLineBorderColor #819BA3
skinparam sequenceArrowThickness 1.2
hide footbox
title Loading the library: foreground and background
participant "Home\n_HomePageState" as H
participant "LokaleDatenbank" as DB
participant "LokalerCoverCache" as C
alt Background synchronization when albums already exist
 H -> H : _bibliothekImHintergrundAktualisieren()\nRemember session version; create a temporary Map
 loop Until next cursor is null
  H -> H : _seiteLesen(client, cursor)\nDetails in diagram 09
  H -> H : Collect albums by ID\ncheck collection cursor for repetition
 end
 H -> H : Check mounted and _auth.epoch
 H -> DB : albumCacheSpeichern(frischeAlben, zeit)
 DB -> DB : Transaction: DELETE + batch INSERT
 DB --> H : Commit completed
 H -> H : Only now replace _alben / setState()
 H ->> C : synchronisieren(frischeAlben)
 note over H,DB : Error before successful saving:\nold cache and current view remain in place.
else Foreground loading in the lab
 H -> H : _albenLaden() / check access
 loop Until complete or a stop is requested
  H -> H : _seiteLesen(client, cursor)
  H -> H : Merge partial results by ID\nshow progress with setState()
 end
 opt Fully loaded
  H -> DB : albumCacheSpeichern(_alben, zeit)
  DB --> H : Successful
  H ->> C : synchronisieren(_alben)
 end
 note over H : Stopping leaves a partial set in RAM.\nOnly complete runs replace the SQLite cache.\nThe foreground path has no equivalent cursor guard.
end
@enduml
